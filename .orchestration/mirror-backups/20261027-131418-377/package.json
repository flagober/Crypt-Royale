{
  "name": "crypt-royale",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "check:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./iniciar_local.ps1 -CheckOnly",
    "package:check": "node scripts/gerar-pacote.cjs --verificar",
    "package:all": "node scripts/gerar-pacote.cjs",
    "desktop": "electron .",
    "postinstall": "node scripts/prepare-build-tools.cjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/core": "6.2.2",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.16",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^8.3.1"
  },
  "main": "electron-main.cjs",
  "description": "Crypt Royale — arena e atividades locais do ecossistema MonsterCrypt",
  "author": "MonsterCrypt",
  "build": {
    "appId": "com.monstercrypt.cryptroyale",
    "productName": "Crypt Royale",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "versao.json",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Crypt Royale Setup 0.6.exe",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Crypt Royale",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "overrides": {
    "@capacitor/cli": {
      "tar": "7.5.22"
    },
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2"
  }
}
